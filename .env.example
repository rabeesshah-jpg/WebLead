# Django core
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Vercel: also set for Preview + Production (or rely on auto VERCEL_URL / .vercel.app merge).
# Example: ALLOWED_HOSTS=whatsapp-voice-lead-agent.vercel.app,.vercel.app
# Comma-separated HTTPS origins for CSRF (e.g. https://app.example.com)
CSRF_TRUSTED_ORIGINS=

# Database: leave empty for local SQLite (data/qualification.sqlite3).
# Production example: postgres://USER:PASSWORD@HOST:5432/DBNAME
# On Vercel without DATABASE_URL, SQLite uses /tmp and migrations run on cold start.
DATABASE_URL=
# Force migrate on every process start (optional; auto-enabled for Vercel SQLite).
DJANGO_MIGRATE_ON_STARTUP=

# Optional Redis for multi-worker qualification persistence / locks / idempotency.
# Leave empty for process-local in-memory backends (fine for local and single-worker Vercel).
QUALIFICATION_REDIS_URL=

# Stable public URLs for production (named Cloudflare tunnel or production domain).
# BASE_WEBHOOK_URL is the public origin n8n uses for internal qualification callbacks.
# PUBLIC_MEDIA_BASE_URL builds WhatsApp voice reply links; defaults to BASE_WEBHOOK_URL when empty.
BASE_WEBHOOK_URL=
PUBLIC_MEDIA_BASE_URL=

# WAHA (WhatsApp HTTP API) — business session for +923301675395
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=
# Optional; when empty inbound webhooks accept X-Api-Key matching WAHA_API_KEY.
WAHA_WEBHOOK_SECRET=
# URL WAHA POSTs message events to (mapped to WHATSAPP_HOOK_URL in docker-compose.waha.yml).
# Local Docker → Django on the host (Linux needs extra_hosts host.docker.internal in compose):
WAHA_HOOK_URL=http://host.docker.internal:8000/api/webhooks/waha/whatsapp-inbound/
# Production example (public Django HTTPS origin):
# WAHA_HOOK_URL=https://your-django-host/api/webhooks/waha/whatsapp-inbound/
# Custom headers on every WAHA → Django webhook POST (Header:Value;Header2:Value2).
# Must match WAHA_WEBHOOK_SECRET or WAHA_API_KEY so Django accepts X-Api-Key.
WAHA_HOOK_CUSTOM_HEADERS=X-Api-Key:replace-me
# Optional public base WAHA embeds in media.url (compose: WAHA_PUBLIC_BASE_URL).
# WAHA_PUBLIC_BASE_URL=https://waha.your-domain.com
WAHA_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
WAHA_MEDIA_MAX_BYTES=10485760

# Master switch for WhatsApp lead qualification (menu, inactivity, extraction).
LEAD_QUALIFICATION_ENABLED=true
# Idle menu may only fire from an explicit inactivity_timer event_source (not user input).
WHATSAPP_MENU_INACTIVITY_SECONDS=600
# Accept numeric/button menu replies for this many seconds after showing the menu.
WHATSAPP_MENU_PENDING_SECONDS=600
# Welcome-back onboarding re-intro after this many seconds idle (default 7200 = 2 hours).
# No longer used for automatic qualification reset; retained for env compatibility.
ONBOARDING_REINTRO_AFTER_SECONDS=7200
SESSION_IDLE_RESET_SECONDS=300
EXISTING_CUSTOMER_FOLLOWUP_DELAY_SECONDS=10
# Production n8n WhatsApp inbound webhook (Django POSTs normalized extract JSON here).
# Legacy alias still accepted in settings: N8N_WHATSAPP_WEBHOOK_URL
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_QUALIFICATION_API_SECRET=
# Optional; when empty Django posts option_template deliveries to N8N_WEBHOOK_URL.
N8N_OPTION_TEMPLATE_WEBHOOK_URL=
# Shared secret for LiveKit Worker post-call completion events (X-WebLead-Secret).
WEBLEAD_VOICE_EVENT_SECRET=
QUALIFICATION_CONFIDENCE_THRESHOLD=0.75

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=20

BOOKING_LINK=https://your-booking-link.com

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en
# Explicit English voice-note transcription configuration.
# Falls back to DEEPGRAM_MODEL and DEEPGRAM_LANGUAGE when unset.
DEEPGRAM_ENGLISH_MODEL=
DEEPGRAM_ENGLISH_LANGUAGE=
# Arabic voice-note transcription configuration.
DEEPGRAM_ARABIC_MODEL=nova-3
DEEPGRAM_ARABIC_LANGUAGE=ar
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_TIMEOUT_SECONDS=60

SUPERTONIC_BASE_URL=http://127.0.0.1:7788
# Existing English voice configuration.
SUPERTONIC_ENGLISH_VOICE=F1
# Arabic voice support is disabled until a voice has been verified manually.
SUPERTONIC_ARABIC_ENABLED=false
SUPERTONIC_ARABIC_VOICE=
MAX_TTS_TEXT_LENGTH=800
WHATSAPP_AUDIO_TTL_SECONDS=86400
SUPERTONIC_TTS_TIMEOUT_SECONDS=60

QUALIFICATION_CONVERSATION_TTL_SECONDS=604800
QUALIFICATION_IDEMPOTENCY_TTL_SECONDS=86400
QUALIFICATION_IDEMPOTENCY_PROCESSING_TTL_SECONDS=300
